services:
  hermes-agent:
    image: nousresearch/hermes-agent:latest
    command:
      - sh
      - -lc
      - |
        set -u

        HERMES_PY=/opt/hermes/.venv/bin/python
        HERMES_BIN=/opt/hermes/.venv/bin/hermes

        if [ -d /opt/hermes ]; then
          chmod -R a+rX /opt/hermes 2>/dev/null || true
          echo "[bootstrap] prava v /opt/hermes normalizovana (a+rX)"
        fi

        cat > /tmp/hermes_dashboard_auth.py <<'PY'
        import datetime
        import os
        import shutil
        import sys

        sys.path.insert(0, "/opt/hermes")

        try:
            import yaml
        except ImportError:
            print("[bootstrap] pyyaml neni k dispozici", file=sys.stderr)
            raise SystemExit(1)

        try:
            from plugins.dashboard_auth.basic import hash_password
        except Exception as exc:
            print("[bootstrap] nelze importovat hash_password: %r" % (exc,), file=sys.stderr)
            raise SystemExit(1)

        home = os.environ.get("HERMES_HOME", "/home/hermes/.hermes")
        path = os.path.join(home, "config.yaml")
        user = os.environ.get("HERMES_DASHBOARD_USER") or "admin"
        password = os.environ.get("HERMES_DASHBOARD_PASSWORD") or ""

        if not password:
            print("[bootstrap] HERMES_DASHBOARD_PASSWORD je prazdne", file=sys.stderr)
            raise SystemExit(1)

        os.makedirs(home, exist_ok=True)

        cfg = {}
        stat = None
        if os.path.exists(path):
            stat = os.stat(path)
            with open(path, "r", encoding="utf-8") as fh:
                cfg = yaml.safe_load(fh) or {}
            if not os.path.exists(path + ".orig.bak"):
                shutil.copy2(path, path + ".orig.bak")
                print("[bootstrap] zaloha ulozena: config.yaml.orig.bak")

        dashboard = cfg.setdefault("dashboard", {})
        basic = dashboard.setdefault("basic_auth", {})
        basic["username"] = user
        basic["password_hash"] = hash_password(password)

        if os.environ.get("HERMES_FORCE_CONFIG_VERSION") == "1":
            cfg["_config_version"] = 12
            print("[bootstrap] _config_version nastavena na 12")

        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            yaml.safe_dump(cfg, fh, sort_keys=False, allow_unicode=True)
        os.replace(tmp, path)

        if stat is not None:
            os.chown(path, stat.st_uid, stat.st_gid)
            os.chmod(path, stat.st_mode & 0o777)
        else:
            os.chown(path, int(os.environ.get("HERMES_UID", "1000")),
                           int(os.environ.get("HERMES_GID", "1000")))
            os.chmod(path, 0o600)

        stamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        print("[bootstrap] %s dashboard.basic_auth nastaveno pro uzivatele '%s'" % (stamp, user))
        PY

        DASH_HOST=0.0.0.0
        if ! PYTHONPATH=/opt/hermes "$$HERMES_PY" /tmp/hermes_dashboard_auth.py; then
          echo "[bootstrap] SELHALO nastaveni auth -> dashboard bezi jen na 127.0.0.1"
          echo "[bootstrap] gateway pobezi dal, dashboard nebude dostupny pres proxy"
          DASH_HOST=127.0.0.1
        fi

        "$$HERMES_BIN" gateway run &
        gateway_pid="$$!"
        "$$HERMES_BIN" dashboard --host "$$DASH_HOST" --port 9119 --no-open &
        dashboard_pid="$$!"

        trap 'kill "$${gateway_pid}" "$${dashboard_pid}" 2>/dev/null; wait' TERM INT

        while kill -0 "$${gateway_pid}" 2>/dev/null && kill -0 "$${dashboard_pid}" 2>/dev/null; do
          sleep 5
        done

        echo "[hermes] jedna ze sluzeb skoncila -> restart kontejneru"
        kill "$${gateway_pid}" "$${dashboard_pid}" 2>/dev/null
        wait
        exit 1
    restart: unless-stopped
    expose:
      - "8642"
      - "9119"
    environment:
      - HERMES_HOME=/home/hermes/.hermes
      - HERMES_UID=${PUID:-1000}
      - HERMES_GID=${PGID:-1000}
      - HERMES_GATEWAY_NO_SUPERVISE=1
      - HERMES_DASHBOARD_USER=${HERMES_DASHBOARD_USER:-admin}
      - HERMES_DASHBOARD_PASSWORD=${HERMES_DASHBOARD_PASSWORD:-${SERVICE_PASSWORD_ADMIN}}
      - HERMES_FORCE_CONFIG_VERSION=${HERMES_FORCE_CONFIG_VERSION:-0}
      - API_SERVER_ENABLED=true
      - API_SERVER_HOST=0.0.0.0
      - API_SERVER_PORT=8642
      - API_SERVER_KEY=${HERMES_API_KEY:-${SERVICE_PASSWORD_ADMIN}}
      - API_SERVER_CORS_ORIGINS=${HERMES_API_CORS_ORIGINS:-*}
      - HERMES_OBSIDIAN_VAULT=/workspace
      - HERMES_DEFAULT_MODEL=${HERMES_DEFAULT_MODEL:-minimax/minimax-m3}
      - OPENROUTER_API_KEY=${OPENROUTER_API_KEY:-}
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
      - OPENAI_API_KEY=${OPENAI_API_KEY:-}
      - GOOGLE_API_KEY=${GOOGLE_API_KEY:-}
      - TZ=${TZ:-Europe/Prague}
    volumes:
      - hermes-home:/home/hermes/.hermes
      - hermes-agent-src:/opt/hermes
      - hermes-workspace:/workspace
      - /var/run/docker.sock:/var/run/docker.sock
    healthcheck:
      test:
        - CMD-SHELL
        - test -d /home/hermes/.hermes && curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:9119/ | grep -qE '^(200|301|302|401)$$'
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s

  hermes-web:
    image: caddy:2-alpine
    restart: unless-stopped
    depends_on:
      - hermes-agent
    expose:
      - "9119"
    environment:
      - SERVICE_URL_HERMESWEB_9119
    command:
      - sh
      - -lc
      - |
        cat > /etc/caddy/Caddyfile <<'EOF'
        :9119 {
          reverse_proxy hermes-agent:9119
        }
        EOF
        exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile

  filebrowser:
    image: filebrowser/filebrowser:s6
    restart: unless-stopped
    user: "0:0"
    expose:
      - "80"
    environment:
      - SERVICE_URL_FILEBROWSER_80
      - PUID=0
      - PGID=0
      - TZ=${TZ:-Europe/Prague}
      - FB_USERNAME=admin
      - FB_PASSWORD=${SERVICE_PASSWORD_ADMIN}
      - FB_NOAUTH=false
      - FB_ROOT=/srv
      - FB_ADDRESS=0.0.0.0
      - FB_PORT=80
      - FB_DATABASE=/database/filebrowser.db
      - FB_CONFIG=/config/settings.json
    volumes:
      - hermes-workspace:/srv/vault
      - hermes-home:/srv/hermes-home
      - hermes-agent-src:/srv/hermes-agent-src
      - filebrowser-database:/database
      - filebrowser-config:/config
    depends_on:
      - hermes-agent

