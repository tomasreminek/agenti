services:
  hermes-agent:
    image: nousresearch/hermes-agent:latest
    command:
      - sh
      - -lc
      - |
        /opt/hermes/.venv/bin/hermes gateway run &
        gateway_pid="$$!"
        /opt/hermes/.venv/bin/hermes dashboard --host 0.0.0.0 --port 9119 --no-open --insecure &
        dashboard_pid="$$!"
        trap 'kill "$${gateway_pid}" "$${dashboard_pid}" 2>/dev/null; wait' TERM INT
        while kill -0 "$${gateway_pid}" 2>/dev/null && kill -0 "$${dashboard_pid}" 2>/dev/null; do
          sleep 5
        done
        kill "$${gateway_pid}" "$${dashboard_pid}" 2>/dev/null
        wait
        exit 1
    restart: unless-stopped
    expose:
      - "8642"
      - "9119"
    environment:
      - HERMES_HOME=/home/hermes/.hermes
      - HERMES_UID=${PUID:-1000}
      - HERMES_GID=${PGID:-1000}
      - API_SERVER_ENABLED=true
      - API_SERVER_HOST=0.0.0.0
      - API_SERVER_PORT=8642
      - API_SERVER_KEY=${HERMES_API_KEY:-${SERVICE_PASSWORD_ADMIN}}
      - API_SERVER_CORS_ORIGINS=${HERMES_API_CORS_ORIGINS:-*}
      - HERMES_OBSIDIAN_VAULT=/workspace
      - HERMES_DEFAULT_MODEL=${HERMES_DEFAULT_MODEL:-minimax/minimax-m3}
      - OPENROUTER_API_KEY=${OPENROUTER_API_KEY:-}
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
      - OPENAI_API_KEY=${OPENAI_API_KEY:-}
      - GOOGLE_API_KEY=${GOOGLE_API_KEY:-}
      - TZ=${TZ:-Europe/Prague}
    volumes:
      - hermes-home:/home/hermes/.hermes
      - hermes-agent-src:/opt/hermes
      - hermes-workspace:/workspace
      - /var/run/docker.sock:/var/run/docker.sock
    healthcheck:
      test:
        - CMD-SHELL
        - test -d /home/hermes/.hermes && curl -fsS http://127.0.0.1:9119/ >/dev/null || exit 1
      interval: 10s
      timeout: 5s
      retries: 5

  hermes-web-proxy:
    image: caddy:2-alpine
    restart: unless-stopped
    depends_on:
      - hermes-agent
    expose:
      - "9119"
    environment:
      - SERVICE_URL_HERMESWEB_9119
      - SERVICE_PASSWORD_ADMIN=${SERVICE_PASSWORD_ADMIN}
    command:
      - sh
      - -lc
      - |
        HASH="$$(caddy hash-password --plaintext "$${SERVICE_PASSWORD_ADMIN}")"
        cat > /etc/caddy/Caddyfile <<EOF
        :9119 {
          basic_auth {
            admin $${HASH}
          }
          reverse_proxy hermes-agent:9119
        }
        EOF
        exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile

  filebrowser:
    image: filebrowser/filebrowser:s6
    restart: unless-stopped
    user: "0:0"
    expose:
      - "80"
    environment:
      - SERVICE_URL_FILEBROWSER_80
      - PUID=0
      - PGID=0
      - TZ=${TZ:-Europe/Prague}
      - FB_USERNAME=admin
      - FB_PASSWORD=${SERVICE_PASSWORD_ADMIN}
      - FB_NOAUTH=false
      - FB_ROOT=/srv
      - FB_ADDRESS=0.0.0.0
      - FB_PORT=80
      - FB_DATABASE=/database/filebrowser.db
      - FB_CONFIG=/config/settings.json
    volumes:
      - hermes-workspace:/srv/vault
      - hermes-home:/srv/hermes-home
      - hermes-agent-src:/srv/hermes-agent-src
      - filebrowser-database:/database
      - filebrowser-config:/config
    depends_on:
      - hermes-agent

  hermes-webui:
    image: ghcr.io/nesquena/hermes-webui:0.51.92
    restart: unless-stopped
    depends_on:
      - hermes-agent
    expose:
      - "8787"
    environment:
      - SERVICE_URL_HERMESWEBUI_8787
      - HERMES_WEBUI_HOST=0.0.0.0
      - HERMES_WEBUI_PORT=8787
      - HERMES_WEBUI_STATE_DIR=/home/hermeswebui/.hermes/webui
      - WANTED_UID=${PUID:-1000}
      - WANTED_GID=${PGID:-1000}
      - HERMES_WEBUI_PASSWORD=${SERVICE_PASSWORD_ADMIN}
      - TZ=${TZ:-Europe/Prague}
    volumes:
      - hermes-home:/home/hermeswebui/.hermes
      - hermes-agent-src:/home/hermeswebui/.hermes/hermes-agent:ro
      - hermes-workspace:/workspace
    healthcheck:
      test:
        - CMD
        - curl
        - -f
        - http://127.0.0.1:8787/health
      interval: 30s
      timeout: 5s
      retries: 3

volumes:
  hermes-home:
  hermes-agent-src:
  hermes-workspace:
  filebrowser-database:
  filebrowser-config:
