services:
  openclaw-gateway:
    # Oficialni image z GHCR (Docker Hub zrcadlo: openclaw/openclaw:latest).
    # Varianty: :latest, :slim, :latest-browser (s Chromiem pro browser-tool), nebo konkretni verze (napr. 2026.2.26).
    image: ${OPENCLAW_IMAGE:-ghcr.io/openclaw/openclaw:latest}
    restart: unless-stopped
    environment:
      - HOME=/home/node
      - OPENCLAW_HOME=/home/node
      - TERM=xterm-256color
      - OPENCLAW_STATE_DIR=/home/node/.openclaw
      - OPENCLAW_CONFIG_PATH=/home/node/.openclaw/openclaw.json
      - OPENCLAW_CONFIG_DIR=/home/node/.openclaw
      - OPENCLAW_WORKSPACE_DIR=/home/node/.openclaw/workspace
      # Token pro prihlaseni do Control UI (Settings -> Gateway Token po prvnim startu).
      - OPENCLAW_GATEWAY_TOKEN=${OPENCLAW_GATEWAY_TOKEN:-${SERVICE_PASSWORD_64_OPENCLAW}}
      - OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=${OPENCLAW_ALLOW_INSECURE_PRIVATE_WS:-}
      - OPENCLAW_DISABLE_BONJOUR=true
      - OPENCLAW_TZ=${TZ:-Europe/Prague}
      - TZ=${TZ:-Europe/Prague}
      # Provider API klice - nejsou oficialne dokumentovane jako primy env-config vstup pro onboarding,
      # takze je nech tu jen jako fallback/pripravu; primarni cesta je dokoncit onboarding v Control UI
      # (Settings) po prvnim prihlaseni tokenem, nebo pres `openclaw-cli` (viz zakomentovana sluzba niz).
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
      - OPENAI_API_KEY=${OPENAI_API_KEY:-}
      - OPENROUTER_API_KEY=${OPENROUTER_API_KEY:-}
      - GOOGLE_API_KEY=${GOOGLE_API_KEY:-}
      # Pro pripojeni na Coolify proxy / expose domenu.
      - SERVICE_URL_OPENCLAWGATEWAY_18789
    volumes:
      - openclaw-home:/home/node/.openclaw
      - openclaw-workspace:/home/node/.openclaw/workspace
      - openclaw-auth-secrets:/home/node/.config/openclaw
    cap_drop:
      - NET_RAW
      - NET_ADMIN
    security_opt:
      - no-new-privileges:true
    extra_hosts:
      - "host.docker.internal:host-gateway"
    init: true
    expose:
      - "18789"
    command:
      - node
      - dist/index.js
      - gateway
      - --bind
      - lan
      - --port
      - "18789"
    healthcheck:
      test:
        - CMD
        - node
        - dist/docker-healthcheck.js
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s

  # ─────────────────────────────────────────────────────────────
  # Volitelna administratorska konzole (docker compose exec openclaw-cli node dist/index.js <prikaz>).
  # Hodi se pro neinteraktivni onboarding / spravu poskytovatelu bez otevirani Control UI.
  # Bezi ve stejnem network namespace jako gateway, proto neni potreba dalsi expose.
  # Odkomentuj pri potrebe:
  # ─────────────────────────────────────────────────────────────
  # openclaw-cli:
  #   image: ${OPENCLAW_IMAGE:-ghcr.io/openclaw/openclaw:latest}
  #   network_mode: "service:openclaw-gateway"
  #   depends_on:
  #     - openclaw-gateway
  #   environment:
  #     - HOME=/home/node
  #     - OPENCLAW_HOME=/home/node
  #     - TERM=xterm-256color
  #     - OPENCLAW_STATE_DIR=/home/node/.openclaw
  #     - OPENCLAW_CONFIG_PATH=/home/node/.openclaw/openclaw.json
  #     - OPENCLAW_CONFIG_DIR=/home/node/.openclaw
  #     - OPENCLAW_WORKSPACE_DIR=/home/node/.openclaw/workspace
  #     - OPENCLAW_GATEWAY_TOKEN=${OPENCLAW_GATEWAY_TOKEN:-${SERVICE_PASSWORD_64_OPENCLAW}}
  #     - BROWSER=echo
  #     - TZ=${TZ:-Europe/Prague}
  #   volumes:
  #     - openclaw-home:/home/node/.openclaw
  #     - openclaw-workspace:/home/node/.openclaw/workspace
  #     - openclaw-auth-secrets:/home/node/.config/openclaw
  #   cap_drop:
  #     - NET_RAW
  #     - NET_ADMIN
  #   security_opt:
  #     - no-new-privileges:true
  #   stdin_open: true
  #   tty: true
  #   init: true
  #   entrypoint: ["node", "dist/index.js"]

  # Jednorazovy init: vygeneruje config.yaml pro FileBrowser Quantum.
  # Kontejner po dobehnuti skonci (v Coolify se zobrazi jako "exited" - je to spravne).
  filebrowser-init:
    image: alpine:3
    restart: "no"
    volumes:
      - filebrowser-data:/data
    command:
      - sh
      - -lc
      - |
        set -e
        mkdir -p /data/tmp

        if [ -f /data/config.yaml ]; then
          echo "[fb-init] config.yaml uz existuje, nechavam beze zmeny"
        else
          cat > /data/config.yaml <<'EOF'
        server:
          port: 80
          cacheDir: /home/filebrowser/data/tmp
          sources:
            - path: /srv/openclaw-workspace
              name: OpenClaw Workspace
              config:
                defaultEnabled: true
            - path: /srv/openclaw-home
              name: OpenClaw config
              config:
                defaultEnabled: true
        auth:
          adminUsername: admin
        EOF
          echo "[fb-init] config.yaml vygenerovan"
        fi

        chown -R 0:0 /data
        echo "[fb-init] hotovo"

  filebrowser:
    image: gtstef/filebrowser:stable
    restart: unless-stopped
    user: "0:0"
    depends_on:
      filebrowser-init:
        condition: service_completed_successfully
    expose:
      - "80"
    environment:
      - SERVICE_URL_FILEBROWSER_80
      - TZ=${TZ:-Europe/Prague}
      - FILEBROWSER_CONFIG=/home/filebrowser/data/config.yaml
      - FILEBROWSER_ADMIN_PASSWORD=${SERVICE_PASSWORD_ADMIN}
    volumes:
      - openclaw-workspace:/srv/openclaw-workspace
      - openclaw-home:/srv/openclaw-home
      - filebrowser-data:/home/filebrowser/data
    healthcheck:
      test:
        - CMD
        - curl
        - -f
        - http://127.0.0.1:80/health
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

volumes:
  openclaw-home:
  openclaw-workspace:
  openclaw-auth-secrets:
  filebrowser-data:
