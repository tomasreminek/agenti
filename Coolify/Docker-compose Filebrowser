services:

  workspace:
    image: node:24-bookworm
    restart: unless-stopped

    working_dir: /home/node/workspace
    user: "1000:1000"

    environment:
      - HOME=/home/node
      - NPM_CONFIG_PREFIX=/home/node/.npm-global
      - PATH=/home/node/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      - TZ=${TZ:-Europe/Prague}

    command:
      - sh
      - -lc
      - |
        mkdir -p /home/node/.npm-global
        mkdir -p /home/node/workspace
        exec sleep infinity

    volumes:
      - workspace-home:/home/node


  filebrowser-init:
    image: filebrowser/filebrowser:s6

    restart: "no"

    entrypoint:
      - /bin/sh
      - -lc

    environment:
      - ADMIN_PASSWORD=${SERVICE_PASSWORD_ADMIN}

    command:
      - |
        set -eu

        if [ ! -f /database/filebrowser.db ]; then
          echo "[init] Vytvarim File Browser databazi..."

          filebrowser config init \
            -d /database/filebrowser.db \
            -r /srv \
            -a 0.0.0.0 \
            -p 80

          filebrowser users add admin "$$ADMIN_PASSWORD" \
            --perm.admin \
            -d /database/filebrowser.db

          echo "[init] Uzivatel admin vytvoren."
        else
          echo "[init] Databaze existuje, aktualizuji heslo admina..."

          filebrowser users update admin \
            --password "$$ADMIN_PASSWORD" \
            --perm.admin \
            -d /database/filebrowser.db

          echo "[init] Heslo admina aktualizovano."
        fi

        chown -R 1000:1000 /database

    volumes:
      - filebrowser-database:/database


  filebrowser:
    image: filebrowser/filebrowser:s6
    restart: unless-stopped

    depends_on:
      filebrowser-init:
        condition: service_completed_successfully

    expose:
      - "80"

    environment:
      - SERVICE_URL_FILEBROWSER_80
      - PUID=1000
      - PGID=1000
      - TZ=${TZ:-Europe/Prague}

      - FB_ROOT=/srv
      - FB_ADDRESS=0.0.0.0
      - FB_PORT=80
      - FB_DATABASE=/database/filebrowser.db
      - FB_CONFIG=/config/settings.json

    volumes:
      - workspace-home:/srv
      - filebrowser-database:/database
      - filebrowser-config:/config


volumes:
  workspace-home:
  filebrowser-database:
  filebrowser-config:
